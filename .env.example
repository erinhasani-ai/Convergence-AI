# Server-side only. Set ONE key. Without any key, SecondLook uses the labeled replay.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: force a provider when both keys are set (anthropic | gemini)
VEHICLEOS_MODEL_PROVIDER=
# Optional model overrides
VEHICLEOS_MODEL_ID=claude-opus-5-5
VEHICLEOS_GEMINI_MODEL=gemini-3.5-flash
